#!/opt/runtime/bin/bash
# URL capture shim, deliberately named xdg-open and placed on PATH.
# The Spotify client opens the login page via `xdg-open <url>` (or $BROWSER),
# and this image ships no desktop browser stack — so instead of opening
# anything, the URL is captured for the web UI to pick up.
set -euo pipefail

url="${1:-}"
if test -z "$url"; then
  echo "xdg-open was called without a URL" >&2
  exit 2
fi

target="${AUTH_URL_FILE:-/data/run/auth-url.txt}"
mkdir -p "$(dirname "$target")"
temporary="${target}.tmp-$$"
printf '%s\n' "$url" > "$temporary"
mv "$temporary" "$target"
echo "Spotify authorization URL captured: $url"
